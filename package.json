{
  "name": "prompt-sage",
  "version": "0.2.1",
  "description": "Prompt Sage, token-efficient communication mode for coding agents.",
  "main": "src/index.js",
  "bin": {
    "prompt-sage": "src/cli.js"
  },
  "scripts": {
    "build:rust": "cargo build --release --manifest-path rust/prompt-sage-rs/Cargo.toml",
    "test": "node --test && npm run test:rust",
    "test:rust": "cargo test --manifest-path rust/prompt-sage-rs/Cargo.toml",
    "sage": "cargo run --quiet --manifest-path rust/prompt-sage-rs/Cargo.toml --",
    "demo:sage": "node scripts/demo-sage.js",
    "stats:sage:internal": "node scripts/stats-sage.js"
  },
  "keywords": [
    "sage",
    "agent",
    "prompting",
    "token-efficiency"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@homebridge/node-pty-prebuilt-multiarch": "^0.13.1",
    "blessed": "^0.1.81",
    "tiktoken": "^1.0.22",
    "xterm-headless": "^5.3.0"
  }
}
